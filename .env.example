# Copy to .env and fill in. Real environment variables override this file.

# Engine: google | mock (mock returns fixed sample output, no credentials needed)
STT_ENGINE=google
STT_LANGUAGE=en-US

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Required only for audio longer than ~1 minute (uploaded for batch recognition)
GCS_BUCKET=your-bucket-name

# Auth: when set, requests must send header "X-API-Key: <value>". Leave empty to disable.
API_KEY=

# Limits
MAX_UPLOAD_MB=100
MAX_WORKERS=4
MAX_RETRIES=3
UPLOAD_DIR=uploads
